---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Reset Password">
  <main class="max-w-sm mx-auto p-6 py-20">
    <h1 class="text-2xl font-bold mb-6 text-center text-emerald-400">Reset Password</h1>
    <form id="reset-form" class="space-y-4">
      <div>
        <label for="email" class="block text-sm font-medium mb-1 text-gray-300">Email</label>
        <input type="email" id="email" required
          class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2 text-gray-100 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" />
      </div>
      <p id="reset-message" class="text-sm hidden"></p>
      <button type="submit"
        class="w-full bg-emerald-600 text-white rounded-lg px-4 py-2.5 font-medium hover:bg-emerald-500 transition-colors">
        Send Reset Email
      </button>
    </form>
    <a href="/" class="block text-center text-sm text-gray-500 mt-4 hover:text-gray-300 transition-colors">
      Back to login
    </a>
  </main>

  <script>
    import { auth } from "../lib/firebase";
    import { sendPasswordResetEmail } from "firebase/auth";

    const form = document.getElementById("reset-form") as HTMLFormElement;
    const message = document.getElementById("reset-message")!;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = (document.getElementById("email") as HTMLInputElement).value;
      try {
        await sendPasswordResetEmail(auth, email);
        message.textContent = "Reset email sent. Check your inbox.";
        message.className = "text-sm text-emerald-400";
      } catch (err: any) {
        message.textContent = err.message;
        message.className = "text-sm text-red-400";
      }
    });
  </script>
</Layout>
