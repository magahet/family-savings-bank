---
import Layout from "../layouts/Layout.astro";
import { APP_NAME, APP_TAGLINE } from "../config";
---

<Layout title="Home">
  <main class="max-w-4xl mx-auto p-6" id="app">
    <div id="loading" class="text-center py-20">
      <p class="text-gray-500">Loading...</p>
    </div>

    <!-- First-run: no admin exists yet. Only the operator-authorized owner email
         can create the admin login here (see scripts/set-owner.ts). -->
    <div id="setup" class="hidden max-w-sm mx-auto py-20">
      <h1 class="text-3xl font-bold mb-2 text-center text-emerald-400">{APP_NAME}</h1>
      <p class="text-center text-gray-500 mb-2 text-sm">Set up your bank</p>
      <!-- Shown when the operator hasn't authorized an owner email yet. -->
      <div id="setup-closed" class="hidden text-center text-gray-500 text-sm mt-6 space-y-2">
        <p>This bank isn't open for setup yet.</p>
        <p class="text-gray-600">The operator must authorize an owner email first:<br />
          <code class="text-gray-400">npx tsx scripts/set-owner.ts you@example.com</code></p>
      </div>
      <p id="setup-open-hint" class="hidden text-center text-gray-500 mb-8 text-sm">Create the administrator login using the authorized owner email. This one-time step locks once the first admin is set.</p>
      <form id="setup-form" class="hidden space-y-4">
        <div>
          <label for="setup-email" class="block text-sm font-medium mb-1 text-gray-300">Email</label>
          <input type="email" id="setup-email" required
            class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2 text-gray-100 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" />
        </div>
        <div>
          <label for="setup-password" class="block text-sm font-medium mb-1 text-gray-300">Password</label>
          <input type="password" id="setup-password" required minlength="6"
            class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2 text-gray-100 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" />
          <p class="text-xs text-gray-600 mt-1">At least 6 characters.</p>
        </div>
        <p id="setup-error" class="text-red-400 text-sm hidden"></p>
        <button type="submit"
          class="w-full bg-emerald-600 text-white rounded-lg px-4 py-2.5 font-medium hover:bg-emerald-500 transition-colors">
          Create admin & continue
        </button>
      </form>
    </div>

    <div id="login" class="hidden max-w-sm mx-auto py-20">
      <h1 class="text-3xl font-bold mb-2 text-center text-emerald-400">{APP_NAME}</h1>
      <p class="text-center text-gray-500 mb-8 text-sm">{APP_TAGLINE}</p>
      <form id="login-form" class="space-y-4">
        <div>
          <label for="email" class="block text-sm font-medium mb-1 text-gray-300">Email</label>
          <input type="email" id="email" required
            class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2 text-gray-100 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" />
        </div>
        <div>
          <label for="password" class="block text-sm font-medium mb-1 text-gray-300">Password</label>
          <input type="password" id="password" required
            class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2 text-gray-100 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" />
        </div>
        <p id="login-error" class="text-red-400 text-sm hidden"></p>
        <button type="submit"
          class="w-full bg-emerald-600 text-white rounded-lg px-4 py-2.5 font-medium hover:bg-emerald-500 transition-colors">
          Sign In
        </button>
      </form>
      <a href="/forgot-password" class="block text-center text-sm text-gray-500 mt-4 hover:text-gray-300 transition-colors">
        Forgot password?
      </a>
    </div>

    <!-- Signed in but no role assigned. -->
    <div id="norole" class="hidden max-w-sm mx-auto py-20 text-center">
      <p class="text-gray-400 mb-6">Your account doesn't have access yet.</p>
      <p class="text-gray-500 text-sm">Ask an administrator to grant you access, then sign out and back in.</p>
      <button id="norole-logout" class="block mx-auto text-sm text-gray-500 hover:text-gray-300 mt-8 transition-colors">Sign Out</button>
    </div>

    <div id="dashboard" class="hidden">
      <header class="flex items-center justify-between mb-8">
        <div>
          <h1 class="text-2xl font-bold text-emerald-400">{APP_NAME}</h1>
          <p class="text-sm text-gray-500">{APP_TAGLINE}</p>
        </div>
        <div class="flex items-center gap-4">
          <a id="settings-link" href="/settings" class="hidden text-sm text-gray-500 hover:text-gray-300 transition-colors">Settings</a>
          <button id="logout-btn" class="text-sm text-gray-500 hover:text-gray-300 transition-colors">Sign Out</button>
        </div>
      </header>

      <div id="admin-bar" class="hidden mb-4">
        <button id="add-account-btn"
          class="text-sm bg-gray-800 border border-gray-700 rounded-lg px-3 py-1.5 text-gray-200 hover:border-gray-600 transition-colors">+ Add account</button>
        <form id="add-account-form" class="hidden mt-3 flex flex-wrap gap-2 items-end bg-gray-900 border border-gray-800 rounded-lg p-4">
          <div>
            <label for="acct-name" class="block text-xs text-gray-500 mb-1">Account name</label>
            <input id="acct-name" placeholder="e.g. Alice"
              class="bg-gray-800 border border-gray-700 rounded-lg px-3 py-1.5 text-gray-100 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500" />
          </div>
          <button type="submit" class="bg-emerald-600 text-white rounded-lg px-3 py-1.5 text-sm font-medium hover:bg-emerald-500 transition-colors">Create</button>
          <button type="button" id="add-account-cancel" class="text-gray-500 text-sm px-2 hover:text-gray-300">Cancel</button>
          <p id="add-account-error" class="w-full text-red-400 text-sm hidden"></p>
        </form>
      </div>

      <div id="accounts-grid" class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      </div>
    </div>
  </main>

  <script>
    import { auth, db, functions } from "../lib/firebase";
    import { onAuthStateChanged, signInWithEmailAndPassword, signOut } from "firebase/auth";
    import { collection, getDocs, setDoc, doc, updateDoc, query, orderBy, Timestamp } from "firebase/firestore";
    import { httpsCallable } from "firebase/functions";

    const el = (id: string) => document.getElementById(id)!;
    const loadingEl = el("loading");
    const setupEl = el("setup");
    const loginEl = el("login");
    const noroleEl = el("norole");
    const dashboardEl = el("dashboard");
    const accountsGrid = el("accounts-grid");
    const adminBar = el("admin-bar");
    const settingsLink = el("settings-link");

    const setupForm = el("setup-form") as HTMLFormElement;
    const setupError = el("setup-error");
    const loginForm = el("login-form") as HTMLFormElement;
    const loginError = el("login-error");

    const needsSetupFn = httpsCallable<unknown, { needsSetup: boolean; ownerEmailSet: boolean }>(functions, "needsSetup");
    const bootstrapFn = httpsCallable<{ email: string; password: string }, { success: boolean }>(functions, "bootstrapFirstAdmin");

    function show(e: HTMLElement) { e.classList.remove("hidden"); }
    function hide(e: HTMLElement) { e.classList.add("hidden"); }
    function only(target: HTMLElement) {
      for (const e of [setupEl, loginEl, noroleEl, dashboardEl]) e === target ? show(e) : hide(e);
    }

    let currentRole: string | null = null;

    onAuthStateChanged(auth, async (user) => {
      hide(loadingEl);
      if (!user) {
        currentRole = null;
        const { needsSetup, ownerEmailSet } = await setupStatus();
        if (needsSetup) {
          // Setup only proceeds once the operator has authorized an owner email.
          el("setup-form").classList.toggle("hidden", !ownerEmailSet);
          el("setup-open-hint").classList.toggle("hidden", !ownerEmailSet);
          el("setup-closed").classList.toggle("hidden", ownerEmailSet);
          only(setupEl);
        } else {
          only(loginEl);
        }
        return;
      }
      const token = await user.getIdTokenResult();
      currentRole = (token.claims.role as string) ?? null;
      if (currentRole === "admin" || currentRole === "child") {
        only(dashboardEl);
        adminBar.classList.toggle("hidden", currentRole !== "admin");
        settingsLink.classList.toggle("hidden", currentRole !== "admin");
        await loadDashboard();
      } else {
        // Signed in but no role — an admin must grant access. (No self-claim path.)
        only(noroleEl);
      }
    });

    async function setupStatus(): Promise<{ needsSetup: boolean; ownerEmailSet: boolean }> {
      try {
        return (await needsSetupFn()).data;
      } catch {
        return { needsSetup: false, ownerEmailSet: false };
      }
    }

    async function refreshAndReload() {
      await auth.currentUser?.getIdToken(true); // pull the new custom claim
      const token = await auth.currentUser?.getIdTokenResult();
      currentRole = (token?.claims.role as string) ?? null;
      only(dashboardEl);
      adminBar.classList.toggle("hidden", currentRole !== "admin");
      settingsLink.classList.toggle("hidden", currentRole !== "admin");
      await loadDashboard();
    }

    setupForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      hide(setupError);
      const email = (el("setup-email") as HTMLInputElement).value.trim();
      const password = (el("setup-password") as HTMLInputElement).value;
      try {
        // The server verifies the email against the authorized owner allowlist,
        // creates the admin account, then we sign in with it.
        await bootstrapFn({ email, password });
        await signInWithEmailAndPassword(auth, email, password);
        await refreshAndReload();
      } catch (err: any) {
        setupError.textContent = err?.message ?? "Setup failed.";
        show(setupError);
      }
    });

    loginForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      hide(loginError);
      const email = (el("email") as HTMLInputElement).value;
      const password = (el("password") as HTMLInputElement).value;
      try {
        await signInWithEmailAndPassword(auth, email, password);
      } catch (err: any) {
        loginError.textContent = err.message;
        show(loginError);
      }
    });

    el("logout-btn").addEventListener("click", () => signOut(auth));
    el("norole-logout").addEventListener("click", () => signOut(auth));

    // ---- admin: add / reorder accounts ----
    const addForm = el("add-account-form") as HTMLFormElement;
    el("add-account-btn").addEventListener("click", () => addForm.classList.toggle("hidden"));
    el("add-account-cancel").addEventListener("click", () => addForm.classList.add("hidden"));

    // Turn a display name into a URL-safe document id: "Alice B." -> "alice-b".
    function slugify(name: string): string {
      return name
        .toLowerCase()
        .normalize("NFKD").replace(/[̀-ͯ]/g, "") // strip accents
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "");
    }

    addForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      hide(el("add-account-error"));
      const name = (el("acct-name") as HTMLInputElement).value.trim();
      if (!name) {
        el("add-account-error").textContent = "Please enter a name.";
        show(el("add-account-error"));
        return;
      }
      const existing = await getDocs(collection(db, "accounts"));
      const taken = new Set(existing.docs.map((d) => d.id));
      // Derive the id from the name; if that's taken (or empty), add a numeric suffix.
      const base = slugify(name) || "account";
      let id = base;
      for (let n = 2; taken.has(id); n++) id = `${base}-${n}`;
      await setDoc(doc(db, "accounts", id), {
        name, order: existing.size, rateOverride: null,
        currentBalance: 0, totalInterest: 0, totalDeposits: 0, totalWithdrawals: 0, totalFines: 0,
        lastComputedAt: Timestamp.now(),
      });
      addForm.reset();
      addForm.classList.add("hidden");
      await loadDashboard();
    });

    let orderedIds: string[] = [];
    async function move(id: string, dir: -1 | 1) {
      const i = orderedIds.indexOf(id);
      const j = i + dir;
      if (j < 0 || j >= orderedIds.length) return;
      const other = orderedIds[j];
      await Promise.all([
        updateDoc(doc(db, "accounts", id), { order: j }),
        updateDoc(doc(db, "accounts", other), { order: i }),
      ]);
      await loadDashboard();
    }

    function fmtMoney(n: number): string {
      const abs = Math.abs(n);
      const [whole, dec] = abs.toFixed(2).split(".");
      const commaWhole = whole.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
      const prefix = n < 0 ? "-" : "";
      return `${prefix}$${commaWhole}<span class="text-[0.7em] align-top">.${dec}</span>`;
    }

    async function loadDashboard() {
      const snap = await getDocs(query(collection(db, "accounts"), orderBy("order")));
      accountsGrid.innerHTML = "";
      orderedIds = snap.docs.map((d) => d.id);

      if (snap.empty) {
        accountsGrid.innerHTML = currentRole === "admin"
          ? '<p class="text-gray-500 col-span-full">No accounts yet — use “+ Add account” above to create one.</p>'
          : '<p class="text-gray-500 col-span-full">No accounts found.</p>';
        return;
      }

      const isAdmin = currentRole === "admin";
      snap.forEach((d, idx) => {
        const data = d.data();
        const card = document.createElement("div");
        card.className = "block bg-gray-900 border border-gray-800 rounded-xl p-5 hover:border-gray-600 transition-colors";
        const balance = (data.currentBalance ?? 0);
        const balanceColor = balance < 0 ? 'text-red-400' : 'text-emerald-400';
        const reorder = isAdmin ? `
          <div class="flex gap-1">
            <button data-move="up" data-id="${d.id}" ${idx === 0 ? "disabled" : ""} class="text-gray-500 hover:text-gray-200 disabled:opacity-30 px-1" title="Move up">↑</button>
            <button data-move="down" data-id="${d.id}" ${idx === snap.size - 1 ? "disabled" : ""} class="text-gray-500 hover:text-gray-200 disabled:opacity-30 px-1" title="Move down">↓</button>
          </div>` : "";
        card.innerHTML = `
          <div class="flex items-center justify-between mb-3">
            <a href="/account?id=${d.id}" class="font-semibold text-lg text-gray-100 hover:text-emerald-400 transition-colors">${data.name}</a>
            ${reorder}
          </div>
          <a href="/account?id=${d.id}" class="block">
            <p class="text-3xl font-bold tabular-nums ${balanceColor} mb-3">${fmtMoney(balance)}</p>
            <div class="grid grid-cols-3 gap-2 text-xs">
              <div><p class="text-gray-500">Interest</p><p class="text-gray-300 tabular-nums">${fmtMoney(data.totalInterest ?? 0)}</p></div>
              <div><p class="text-gray-500">Deposits</p><p class="text-gray-300 tabular-nums">${fmtMoney(data.totalDeposits ?? 0)}</p></div>
              <div><p class="text-gray-500">Fines</p><p class="text-red-400 tabular-nums">${fmtMoney(data.totalFines ?? 0)}</p></div>
            </div>
          </a>
        `;
        accountsGrid.appendChild(card);
      });

      accountsGrid.querySelectorAll<HTMLButtonElement>("button[data-move]").forEach((btn) => {
        btn.addEventListener("click", () => move(btn.dataset.id!, btn.dataset.move === "up" ? -1 : 1));
      });
    }
  </script>
</Layout>
