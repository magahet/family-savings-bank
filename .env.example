# Copy to .env and customize. All PUBLIC_* vars are exposed to the browser.

# Default branding + the PWA (installed-app) name. An admin can override the
# in-app name/tagline any time via Settings → App name, no redeploy needed.
PUBLIC_APP_NAME="Family Savings Bank"
PUBLIC_APP_SHORT_NAME="Savings Bank"
PUBLIC_APP_TAGLINE="Family Savings Tracker"
