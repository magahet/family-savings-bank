rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == "admin";
    }

    function isChild() {
      return isAuthenticated() && request.auth.token.role == "child";
    }

    match /accounts/{childId} {
      allow read: if isAdmin() || isChild();
      allow write: if isAdmin();

      match /transactions/{txId} {
        allow read: if isAdmin() || isChild();
        allow write: if isAdmin();
      }

      match /monthly/{monthId} {
        allow read: if isAdmin() || isChild();
        allow write: if false;
      }
    }

    // The interest rate is read by the client (rate display / next-interest estimate).
    match /settings/interest {
      allow read: if isAdmin() || isChild();
      allow write: if isAdmin();
    }

    // settings/api holds summaryPath, the secret Storage path that gates the
    // public summary JSON. Only Cloud Functions need it (Admin SDK bypasses
    // rules), so no client — not even an admin — should read it.
    match /settings/api {
      allow read: if false;
      allow write: if isAdmin();
    }

    // Any other settings doc: deny by default.
    match /settings/{doc} {
      allow read: if false;
      allow write: if isAdmin();
    }
  }
}
