{
  "name": "family-savings-bank",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "emulators": "firebase emulators:start --project demo-savings-bank",
    "seed": "npx tsx scripts/seed-emulator.ts",
    "dev:full": "firebase emulators:start --project demo-savings-bank --only auth,firestore & GCLOUD_PROJECT=demo-savings-bank npm run seed && astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "astro": "^6.1.8",
    "firebase": "^11.0.0",
    "fuse.js": "^7.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "firebase-admin": "^13.8.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.21.0",
    "xlsx": "^0.18.5"
  }
}
